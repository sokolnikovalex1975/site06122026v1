# ПЕСТКОНТРОЛЬ Центр — правила сервера.
# Перенаправление на HTTPS включено в панели Timeweb.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Единый адрес сайта: www.пестконтроль-центр.рф -> пестконтроль-центр.рф
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Служебные файлы почтовой библиотеки не открываются из браузера
  RewriteRule ^vendor/(composer|phpmailer)(/|$) - [F,L]
  RewriteRule ^vendor/autoload\.php$ - [F,L]

  # Адрес папки без слеша: сразу https и слеш — один переход вместо двух (решение владельца 18.11.2026)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.+)$ https://%{HTTP_HOST}/$1/ [R=301,L]

  # /index.php и /раздел/index.php — на адрес со слешем (только прямой запрос, не внутренняя подстановка index.php)
  # и только если такая папка есть на сайте; адреса несуществующих папок отвечают 404
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(.*/)?index\.php[\s?] [NC]
  RewriteCond %{REQUEST_FILENAME} ^(.*/)index\.php$ [NC]
  RewriteCond %1 -d
  RewriteRule ^(.*/)?index\.php$ https://%{HTTP_HOST}/$1 [R=301,L,NC]
</IfModule>

# Своя страница «Страница не найдена» (tools/site/page_404.py); код ответа остаётся 404 (решение владельца 18.11.2026)
ErrorDocument 404 /404.html
